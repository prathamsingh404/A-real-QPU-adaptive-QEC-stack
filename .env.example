# AdaptiveQEC Environment Configuration Template
# ================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# IBM Quantum credentials
# For ibm_cloud channel (CRN-based access):
IBM_QUANTUM_TOKEN=your_api_key_here
IBM_QUANTUM_CHANNEL=ibm_cloud
IBM_QUANTUM_INSTANCE=your_crn_here
IBM_QUANTUM_BACKEND=ibm_marrakesh

# For legacy ibm_quantum channel:
# IBM_QUANTUM_TOKEN=your_api_key_here
# IBM_QUANTUM_CHANNEL=ibm_quantum
# IBM_QUANTUM_INSTANCE=
# IBM_QUANTUM_BACKEND=ibm_brisbane
